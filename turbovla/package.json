    "@types/node": "^24.19.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.3.1",
